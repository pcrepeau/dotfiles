    //"format": "<span size='12pt'>{icon}</span>",
    //"format-icons": {
       //"notification": "󱅫",
       //"none": "󰂜",
       //"dnd-notification": "󰂠",
       //"dnd-none": "󰪓",
       //"inhibited-notification": "󰂛",
       //"inhibited-none": "󰪑",
       //"dnd-inhibited-notification": "󰂛",
       //"dnd-inhibited-none": "󰪑"
    //},
